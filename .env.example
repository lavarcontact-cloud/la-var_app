# Copier en .env.local (jamais commité). Valeurs locales : `npx supabase status -o env`.

# Supabase (public : exposé au navigateur, protégé par les règles RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SECRET, serveur uniquement) : devis (/api/quote) et ingestion (/api/ingest)
SUPABASE_SERVICE_ROLE_KEY=

# Secret partagé avec la tâche planifiée Vercel (en-tête Authorization: Bearer …)
CRON_SECRET=

# Facultatif : sel de l'empreinte d'IP anti-spam des devis (par défaut : clé service)
IP_HASH_SALT=

# Facultatif : URL publique canonique (sinon VERCEL_URL, sinon localhost)
NEXT_PUBLIC_SITE_URL=

# Mettre à 1 uniquement au lancement public : autorise l'indexation par les moteurs
SITE_INDEXABLE=
